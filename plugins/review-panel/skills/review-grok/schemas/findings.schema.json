{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review-panel default-mode findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "file", "line", "stance", "claim", "trigger", "observed", "evidence"],
        "properties": {
          "title": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "stance": { "type": "string", "enum": ["delivery", "dependency", "identity", "conformance", "situate"] },
          "claim": { "type": "string" },
          "trigger": { "type": "string" },
          "observed": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
