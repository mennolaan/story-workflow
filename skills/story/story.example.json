{
  "checkpointPercent": 35,
  "backstopTokens": 432000,
  "baseBranch": "main",
  "branch": "feature/{id}-{slug}",
  "board": { "show": "gh issue view {id}", "reads": [], "readTools": [] },
  "pr": { "create": "gh pr create --draft --base {base} --head {branch} --title {title} --body {description}" },
  "guard": { "deny": [], "denyTools": [] },
  "planBoundary": false,
  "parallel": { "max": 10, "shared": ["**/package-lock.json", "**/yarn.lock", "**/pnpm-lock.yaml", "CHANGELOG.md"] },
  "routing": { "startupTokens": 100000, "targetSessionTokens": 200000, "largeStory": { "storyPoints": 30 } },
  "handoffReview": { "effort": "high", "maxRounds": 2, "maxParallel": 3, "timeoutSeconds": 600, "maxCheckFailures": 2 },
  "conventions": "CLAUDE.md"
}
